{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash scripts/ensure-opendataloader-stub.sh && HUSKY=0 pnpm install --frozen-lockfile",
  "buildCommand": "bash scripts/vercel-build-mobile.sh",
  "outputDirectory": "apps/mobile/dist",
  "functions": {
    "api/tts/synthesize.ts": {
      "maxDuration": 30,
      "includeFiles": "apps/mobile/src/voice/synthesizeEdgeTts.ts"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
