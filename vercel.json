{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash scripts/ensure-opendataloader-stub.sh && HUSKY=0 pnpm install --frozen-lockfile",
  "buildCommand": "bash scripts/vercel-build-mobile.sh",
  "outputDirectory": "apps/mobile/dist",
  "functions": {
    "api/tts/synthesize.ts": {
      "maxDuration": 30,
      "includeFiles": "apps/mobile/src/voice/synthesizeEdgeTts.ts"
    },
    "api/llm/chat.ts": {
      "maxDuration": 30,
      "includeFiles": "apps/mobile/src/chat/llmProxyRequest.ts"
    },
    "api/community-hub/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "apps/mobile/src/features/communityHubProxy.ts"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network-access=(self), local-network=(self), loopback-network=(self)"
        }
      ]
    }
  ]
}
