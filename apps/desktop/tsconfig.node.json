{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  // Vitest mocks are checked by tests + p2p-event.service.mock.ts, not husky tsc.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.integration.test.ts"
  ]
}
