{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash ../../scripts/ensure-opendataloader-stub.sh && cd ../.. && HUSKY=0 pnpm install --frozen-lockfile",
  "buildCommand": "bash ../../scripts/vercel-build-mobile.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/tts/synthesize.ts": {
      "maxDuration": 30
    },
    "api/llm/chat.ts": {
      "maxDuration": 30
    },
    "api/community-hub.ts": {
      "maxDuration": 30
    },
    "api/community-hub/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network-access=*, loopback-network=*, local-network=*, autoplay=(self)"
        }
      ]
    }
  ]
}
